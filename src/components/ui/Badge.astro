---
interface Props {
  tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;
const classes = tone === 'dark'
  ? 'border-white/25 text-white/80'
  : 'border-[var(--cg-hairline)] text-[var(--cg-primary)]';
---

<span class={`inline-flex border px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] ${classes}`}>
  <slot />
</span>
