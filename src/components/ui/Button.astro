---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;
const classes = variant === 'primary'
  ? 'bg-blue-500 text-white hover:bg-blue-400'
  : 'border border-white/15 text-white hover:border-white/40 hover:bg-white/5';
---

<a href={href} class={`inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold transition ${classes}`}>
  <slot />
</a>
