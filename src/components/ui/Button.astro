---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;
const classes = variant === 'primary'
  ? 'bg-[var(--cg-primary)] text-white hover:bg-[var(--cg-primary-active)]'
  : 'border border-white text-white hover:bg-white hover:text-[var(--cg-ink)]';
---

<a href={href} class={`inline-flex h-12 items-center justify-center px-8 text-sm font-bold tracking-[0.04em] transition ${classes} ${className}`}>
  <slot />
</a>
